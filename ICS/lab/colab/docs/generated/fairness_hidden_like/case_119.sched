track fairness
score fairness_share_skew
role leaderboard
scenario_weight = 1.00
workers 20
cpu_rate 26
switch_cost 8
node n0 0-9
node n1 10-19
migration_cost local=8 remote=32

phase topo at 0us:
  group local_pressure * 8 weight=1 arrival stagger 91us:
    repeat 9:
      compute 60
  group remote_heavy * 6 weight=9 arrival delay 1050us:
    repeat 10:
      compute 252
      sleep 80us
