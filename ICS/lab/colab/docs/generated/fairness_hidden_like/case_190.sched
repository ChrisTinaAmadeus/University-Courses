track fairness
score fairness_share_skew
role leaderboard
scenario_weight = 1.00
workers 10
cpu_rate 14
switch_cost 3
migration_cost 14

phase light_flood at 0us:
  group light_flood * 40 weight=1 arrival burst 10 every 10us:
    repeat 10:
      compute 50

phase heavy_arrives at 300us:
  group heavy_late * 3 weight=6 arrival stagger 180us:
    repeat 5:
      compute 80
