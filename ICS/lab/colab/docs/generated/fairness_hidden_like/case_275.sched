phase cyclic at 0us:
  group light_cyclic * 16 weight=1:
    repeat 3:
      compute 85
      sleep 285us
      compute 95
  group heavy_cyclic * 3 weight=4:
    repeat 3:
      compute 170
      sleep 855us
      compute 100
