track fairness
score fairness_share_skew
role leaderboard
scenario_weight = 1.00
workers 10
cpu_rate 28
switch_cost 5
migration_cost 5

phase cyclic at 0us:
  group light_cyclic * 12 weight=1:
    repeat 3:
      compute 25
      sleep 285us
      compute 35
  group heavy_cyclic * 3 weight=4:
    repeat 3:
      compute 50
      sleep 855us
      compute 40
