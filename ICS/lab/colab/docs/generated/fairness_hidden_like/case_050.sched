track fairness
score fairness_share_skew
role leaderboard
scenario_weight = 1.00
workers 10
cpu_rate 14
switch_cost 3
migration_cost 10

phase light_flood at 0us:
  group light_flood * 50 weight=1 arrival burst 10 every 10us:
    repeat 8:
      compute 90

phase heavy_arrives at 300us:
  group heavy_late * 2 weight=6 arrival stagger 80us:
    repeat 5:
      compute 80
