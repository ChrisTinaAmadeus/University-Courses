track fairness
score fairness_share_skew
role leaderboard
scenario_weight = 1.00
workers 8
cpu_rate 20
switch_cost 3
migration_cost 10

phase asym_block at 0us:
  group continuous * 6 weight=7:
    repeat 8:
      compute 74
  group blocking * 16 weight=1 arrival burst 4 every 460us:
    repeat 7:
      compute 64
      sleep 110us
      compute 54
