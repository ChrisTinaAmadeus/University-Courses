track fairness
score fairness_share_skew
role leaderboard
scenario_weight = 1.00
workers 4
cpu_rate 30
switch_cost 6
migration_cost 8

phase mixed at 0us:
  group steady * 18 weight=1:
    repeat 10:
      compute 125
      sleep 640us
      compute 60
  group sleeper * 16 weight=3 arrival burst 6 every 740us:
    repeat 8:
      compute 64
      sleep 400us
      compute 20
